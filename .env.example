# ============ 阿里云百炼平台 ============
# 在百炼控制台获取：https://bailian.console.aliyun.com/ -> 模型广场 -> API Key
DASHSCOPE_API_KEY=your_bailian_api_key_here

# 百炼 OpenAI 兼容协议端点（固定值）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============ 模型配置（4 个百炼模型） ============
# 分诊/结构化提取/报告主力
MODEL_INTAKE=qwen3.7-plus
# 开放对话/共情干预
MODEL_DIALOG=deepseek-v4-pro-0813
# 高频/兜底/报告辅助
MODEL_REPORT=deepseek-v4-flash-0731
# RAG 向量化
MODEL_EMBED=text-embedding-v3

# ============ Chroma 向量库 ============
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ============ SQLite ============
# 容器内路径（挂载到宿主机 ./data/psycheflow.db）
SQLITE_PATH=/app/data/psycheflow.db

# ============ FastAPI ============
APP_HOST=0.0.0.0
APP_PORT=8000
# 前端地址（CORS）
FRONTEND_ORIGIN=http://localhost:5173

# ============ 安全（青少年合规） ============
# 是否记录审计日志
ENABLE_AUDIT_LOG=true
# 危机转介热线（青少年）
CRISIS_HOTLINE_12355=12355
