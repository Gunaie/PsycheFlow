# ============ 阿里云百炼平台 ============
# 在百炼控制台获取：https://bailian.console.aliyun.com/ -> 模型广场 -> API Key
DASHSCOPE_API_KEY=your_bailian_api_key_here

# 百炼 OpenAI 兼容协议端点（固定值）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============ 模型配置（百炼模型） ============
# 结构化提取/计分辅助（MoE 架构，分类精准）
MODEL_INTAKE=qwen3.8-2.4t-a95b
# 意图分类（关思考链 enable_thinking=False，4 类标签输出快；triage 节点专用）
MODEL_TRIAGE=qwen3.8-27b
# 开放对话/共情（deepseek-v4 有 reasoning_content 思考链，max_tokens 须够大）
MODEL_DIALOG=deepseek-v4-pro-0813
# 流式干预专用（关思考链 enable_thinking=False，首 token ~0.58s；SSE /api/chat/stream 用此角色）
MODEL_DIALOG_STREAM=qwen3.8-max
# 高频/兜底/报告辅助（deepseek-v4 有 reasoning_content 思考链）
MODEL_REPORT=deepseek-v4-flash-0731
# RAG 向量化
MODEL_EMBED=text-embedding-v3
# 语音识别（DashScope 原生 multimodal-generation HTTP）
MODEL_ASR=qwen-audio-3.0-asr-flash
# 语音合成（DashScope 原生 audio/tts HTTP）
MODEL_TTS=qwen-audio-3.0-tts-flash
# TTS 音色（见百炼音色列表）
TTS_VOICE=longanhuan_v3.6

# ============ Chroma 向量库 ============
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ============ SQLite ============
# 容器内路径（挂载到宿主机 ./data/psycheflow.db）
SQLITE_PATH=/app/data/psycheflow.db

# ============ FastAPI ============
APP_HOST=0.0.0.0
APP_PORT=8000
# 前端地址（CORS）
FRONTEND_ORIGIN=http://localhost:5173

# ============ 安全（青少年合规） ============
# 是否记录审计日志
ENABLE_AUDIT_LOG=true
# 危机转介热线（青少年）
CRISIS_HOTLINE_12355=12355
# SQLite 备份加密口令（合规 c：AES-256-CBC；空则 scripts/backup_db.py 拒绝备份）
# 生产务必设强随机口令，勿入库勿共享
BACKUP_PASSPHRASE=

# ============ Ollama 本地兜底（五期：百炼失败/离线时回退本地 LLM） ============
# 空 = 禁用，保持 cloud-only；启用后整机共享独立容器（模型库多项目复用，不占 C 盘）：
#   docker run -d --name ollama --gpus all -p 11434:11434 -v E:/OllamaModels:/root/.ollama --restart always ollama/ollama:latest
#   docker run -d -p 3001:8080 -e OLLAMA_BASE_URL=http://host.docker.internal:11434 -v open-webui:/app/backend/data --name open-webui --restart always ghcr.io/open-webui/open-webui:main
# 启用兜底：OLLAMA_BASE_URL=http://host.docker.internal:11434/v1（容器内连宿主共享 Ollama）
OLLAMA_BASE_URL=
# 本地模型名（需先 `docker exec ollama ollama pull qwen2.5:7b` 或从 GGUF 导入）
OLLAMA_MODEL=qwen2.5:7b
